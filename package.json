{
  "name": "auto-jev-codex",
  "private": true,
  "version": "0.2.0",
  "description": "A Paseo provider that uses TypeSafe Jev to route each Codex turn.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obetomuniz/auto-jev-codex.git"
  },
  "homepage": "https://github.com/obetomuniz/auto-jev-codex#readme",
  "bugs": {
    "url": "https://github.com/obetomuniz/auto-jev-codex/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "paseo",
    "codex",
    "typesafe",
    "model-router"
  ],
  "scripts": {
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "pretest": "node -e \"require('node:fs').rmSync('.test-build',{recursive:true,force:true})\"",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.8.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^24.5.2",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
